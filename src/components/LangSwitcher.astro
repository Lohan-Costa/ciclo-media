---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { languages, type Lang } from '../i18n/ui';

interface Props {
	lang: Lang;
	/** Current path with any locale prefix already stripped, e.g. "/orbita" */
	path: string;
}

const { lang, path } = Astro.props;
const locales = Object.keys(languages) as Lang[];
---

<div class="lang-switch">
	{
		locales.map((locale) => (
			<a
				href={getRelativeLocaleUrl(locale, path)}
				aria-current={locale === lang ? 'true' : 'false'}
			>
				{locale.toUpperCase()}
			</a>
		))
	}
</div>
